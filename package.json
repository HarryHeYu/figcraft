{
  "name": "dsh-figcraft",
  "version": "0.1.0",
  "description": "PaperCanvas figures for DeepSeek Harness. Create, patch, lay out, lint and export publication-ready SVG/PDF/PPTX figures as DSH tools.",
  "type": "module",
  "main": "./dsh-plugin/lib/index.js",
  "types": "./dsh-plugin/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dsh-plugin/lib/index.d.ts",
      "default": "./dsh-plugin/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin/lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "HarryHeYu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarryHeYu/figcraft.git"
  },
  "homepage": "https://github.com/HarryHeYu/figcraft#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "figcraft",
    "papercanvas",
    "scientific-figures",
    "svg",
    "mcp",
    "diagram-as-code"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test \"dsh-plugin/tests/**/*.test.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || >=4.0.5-alpha.1 <5.0.0 || >=4.0.6-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.3 <0.2.0-0 || >=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-alpha.1 <0.3.0-0 || >=0.2.1-rc.1 <0.3.0-0 || >=0.2.2-alpha.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bugs": "https://github.com/HarryHeYu/figcraft/issues"
}
